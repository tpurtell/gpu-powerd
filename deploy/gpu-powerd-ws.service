# gpu-powerd-ws: read-only WebSocket relay of gpu-powerd's samples. It runs as a
# transient unprivileged user with no capabilities: the root daemon never opens a
# network socket; it publishes on a local Unix socket that this service reads.
# NO AUTHENTICATION: anyone who can reach websocket_bind:websocket_port sees the samples.
[Unit]
Description=gpu-powerd WebSocket stream relay (read-only)
Documentation=https://github.com/tpurtell/gpu-powerd
After=gpu-powerd.service network.target
Wants=gpu-powerd.service

[Service]
ExecStart=/usr/local/bin/gpu-powerd-ws --config /etc/gpu-powerd/config.toml
Restart=always
RestartSec=2
DynamicUser=yes
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
